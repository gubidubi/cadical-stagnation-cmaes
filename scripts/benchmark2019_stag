for (( i=$INICIO; i<=$FIM; i++ )); do
	FILENAME=$(sed -n "${i}p" cadical/file_list.txt)
	echo -n "$FILENAME "
	./cadical/cadical-stagnation/build/cadical -n -q --restartbasefast=11 --restartbaseslow=301 -t 5000 --seed=0 "cadical/$FILENAME"
done
