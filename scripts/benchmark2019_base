module load gcc/12.4.0

for (( i=$INICIO; i<=$FIM; i++ )); do
    FILENAME=$(sed -n "${i}p" cadical/file_list.txt)
    [[ -z "$FILENAME" ]] && continue
    echo -n "$FILENAME "
    ./cadical/cadical/build/cadical -n -t 5000 --seed=0 "cadical/$FILENAME"
done
